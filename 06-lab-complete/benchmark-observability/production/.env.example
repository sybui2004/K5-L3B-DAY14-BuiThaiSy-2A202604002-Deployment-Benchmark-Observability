# Copy thành .env để đổi cấu hình stack: cp .env.example .env
# docker compose tự đọc file .env trong cùng thư mục.

# Phiên bản agent: v1 (không retrieval) | v2 (có retrieval/RAG)
AGENT_VERSION=v2
# Model: mock-llm-small | mock-llm-large (đắt hơn ~16 lần, chậm hơn 2.5 lần)
LLM_MODEL=mock-llm-small

# JWT auth — /ask cần Authorization: Bearer <token> lấy từ POST /auth/token.
# Thiếu biến / secret < 32 byte → agent không khởi động. Đổi secret khi dùng ngoài máy mình:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=lab-only-insecure-jwt-secret-change-me-0123456789
AUTH_USERNAME=demo
AUTH_PASSWORD=lab-only-demo-password
JWT_EXPIRE_MINUTES=60

# Fault injection — dùng cho bài tập "phá hệ thống và quan sát"
MOCK_LATENCY_MS=120
MOCK_SLOW_RATE=0.03
MOCK_ERROR_RATE=0.01
